[ext_resource type="Script" path="res://Library/ExtraLibrary/extra_book_config.gd" id="1_7e7l2"]

[resource]
script = ExtResource("1_7e7l2")
title = "野区怪物其二"
content = "野区怪物的身体特征呈现为高度腐烂的肉体，且目前关于其行动能量来源仍是未解之谜。他们虽然会主动攻击非亡灵生物，一部分怪物甚至会啃咬血肉，但这似乎并非捕猎与进食行为，只是单纯处于本能，血肉并非他们行动的能量来源。
 
目前已知的野区怪物多为丧尸，且是野区数量最多的怪物之一。如果深入野区深处地带，野区怪物的分布密度会越来越高，且会更加频繁地出现那种高大危险的野区怪物，如击杀难度极大的终末。根据传闻，在人族帝国的丛林野区中，有一批冒险小队曾成功深入过丛林核心地带，但这支九人小队最终只有一人活着回来，还失去了一支手臂，最终这个人还在严重的精神疾病的折磨下痛苦死去。
 
史蒂夫将军率领的远征军曾成功穿过了一整片丛林，并击杀了高达三十米的巨型泰坦丧尸，但他们也并没有真正抵达核心地区。据将军所言，即使是一整支帝国级的军队，在真正深入丛林之后那里野区怪物的数量与危险程度也会让他们抱头鼠窜。即便依然有更深入的地区没能抵达，但他们所踏足的地区其深入程度也是历史性的贡献。"
texture_alpha = 0.4
unlock_tag = "normal"
