[ext_resource type="Script" path="res://Library/ExtraLibrary/extra_book_config.gd" id="1_v1tch"]

[resource]
script = ExtResource("1_v1tch")
title = "野区怪物其一"
content = "野区怪物诞生自野区，不同的野区会诞生不同的野区怪物，如丛林诞生的怪物多为植被覆盖的腐化丧尸，沙漠诞生的怪物多为干枯的瘪尸。经过确认，野区怪物绝无本能外的其他意识，只会攻击非野区怪物的任何生物。
 
这些野区怪物与尸国骨国等原住民长相接近，只是身体因高度腐烂而难以分辨，但是他们仍会攻击尸国骨国的居民。且经过确认，二者只是样貌相近，其他地方完全不同。
 
在史蒂夫将军进军丛林地带追击溃败的尸骨联军时，这支联军曾被困在野区内部遭遇大批怪物袭击，损失惨重，也因此不得不和史蒂夫的军队在丛林中临时合作对抗野区怪物。
 
经过确认，尸国骨国居住的那片大陆并不存在野区这种地带，也因此在人族帝国南部无人区丛林地带遭遇野区怪物袭击时十分意外。"
texture_alpha = 0.4
unlock_tag = "normal"
