[ext_resource type="Script" path="res://Library/ExtraLibrary/extra_book_config.gd" id="1_0j36i"]

[resource]
script = ExtResource("1_0j36i")
title = "野区其四"
content = "我们并不孤单。曾有一片大陆在几百年前与人族帝国（前王朝）保持着联络，但在野区出现之后人族帝国便与那片大陆失去了音信。经过王朝更迭与百年的抗争之后，我们仍未有那片大陆的消息。在对抗尸骨联军入侵后，史蒂夫将军率军追击敌军进入丛林，并随着他们的踪迹进入了曾经的那片大陆。
 
整片大陆都是野区，没有任何一处地区是人类活动的地方，甚至残存的人类仅仅处于部落的阶段，生活方式及其落后，但是从那片沙漠残存的风化的残垣断壁来看，这片大陆曾是一片高度发达的繁华文明地带。或许正是野区摧毁了这一整个文明。
 
沙漠地区残存的人类与沙漠野区怪物处于暂时共存的状态，这些沙漠游牧民族要时刻做好搬迁规避野区怪物的准备，因此他们的住所多为移动的帐篷，一群移动帐篷聚在一起形成暂时的小型村落。"
unlock_tag = "normal"
