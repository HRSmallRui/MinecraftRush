[ext_resource type="Script" path="res://Library/ExtraLibrary/extra_book_config.gd" id="1_dq0el"]

[resource]
script = ExtResource("1_dq0el")
title = "野区其一"
content = "野区起源于几百年前的一颗流星，在那颗流星坠毁到帝国的南部无人区丛林地带之后，整片丛林便化作了一片黑暗森林，源源不断地从中冒出不死的亡灵生物。自此，人类与野区怪物的战斗拉开帷幕，持续了有一百多年。由于对怪物的研究不足，在开始的抗衡中人类的损失也相当惨重。
 
关于怪物是如何出现的，至今仍是个谜。有学者认为，怪物的起源之地可能位于丛林最深处的中心地带，但至今仍没有人能到达那里，也无人能验证假说的真伪。不过值得一提的是，如果将人类的尸体埋葬在靠近野区深处的地方，那具尸体有极大的概率会转化成野区怪物，同时在丛林偏深处不同的位置埋葬的尸体转化的野区怪物也不尽相同，我们至今仍无从得知血肉之躯是怎么转化成火药（腐化爬行者自爆的主要能量来源）的。"
unlock_tag = "normal"
