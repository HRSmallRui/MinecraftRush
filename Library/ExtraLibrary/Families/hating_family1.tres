[ext_resource type="Script" path="res://Library/ExtraLibrary/extra_book_config.gd" id="1_vesi5"]

[resource]
script = ExtResource("1_vesi5")
title = "特斯拉家族其一"
content = "尼古拉斯曾是厌鸣帝国最具有压迫力的皇帝，也是特斯拉家族力量的巅峰代表，不过一切都随着战争结束之后烟消云散。论其一生，他无疑是个不折不扣的战争狂人与十恶不赦的千古罪人，在其曾祖在一场侵略战争中去世之后，特斯拉家族一直退居厌鸣帝国长达几百年时间，直到尼古拉斯即位。
 
尼古拉斯即位后并没有大肆进行侵略行动，而是暗中挑动人族帝国与尸国骨国的战争，并在之后一步步布下暗棋坐收渔翁之利，夺取了尸国骨国收集的神器碎片。他先是挑起了尸国骨国组成联军入侵人族帝国，接着暗示他们隐藏在野区中的神器碎片拥有扭转战局的力量，接着在尸骨联军被野区怪物围攻至残之时出面拿走了他们辛苦收集的神器碎片，配合自己此前种种暗中行动收集的其他碎片与上古石板进行解读，最终得以修复曾祖留下的残缺神器，拥有了毁天灭地的神力，之后直接摊牌派出大批军队入侵人族帝国。
 
不过或许尼古拉斯怎么也想不到自己会折损在人族帝国，明明已经有了必胜的把握，但还是在最后被史蒂夫扭转战局。神器随着他的死亡而自此消失不见，或许是彻底毁灭了。尼古拉斯死后，其长子伏特即位，由此世界再次迎来难得的平和时期。"
texture_alpha = 0.4
unlock_tag = "normal"
