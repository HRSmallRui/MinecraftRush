[gd_resource type="Resource" script_class="HeroSkillTextBlock" load_steps=2 format=3 uid="uid://iv150gmw4nku"]

[ext_resource type="Script" path="res://Library/Heroes/hero_skill_text_block.gd" id="1_kbgb1"]

[resource]
script = ExtResource("1_kbgb1")
skill_name = "落日圆舞曲"
skill_intro = Array[String](["落下一片箭雨，对大范围内所有敌人造成50点物理伤害，并在1.5秒后爆炸，对敌人造成100-120点范围伤害，同时施加持续8秒的易伤效果，在此期间受到的伤害增加60%。", "落下一片箭雨，对大范围内所有敌人造成80点物理伤害，并在1.5秒后爆炸，对敌人造成160-200点范围伤害，同时施加持续8秒的易伤效果，在此期间受到的伤害增加60%。", "落下一片箭雨，对大范围内所有敌人造成120点物理伤害，并在1.5秒后爆炸，对敌人造成240-280点范围伤害，同时施加持续8秒的易伤效果，在此期间受到的伤害增加60%。"])
