[ext_resource type="Script" path="res://Library/Heroes/hero_skill_text_block.gd" id="1_e31ba"]

[resource]
script = ExtResource("1_e31ba")
skill_name = "此剑，献与世界"
skill_intro = Array[String](["锁定一定范围内的所有敌人然后出鞘，期间所有敌人处于定身状态，随后收刀，结束后对命中的所有敌人造成100-140点真实伤害，同时获得持续10秒的力量提升效果。", "锁定一定范围内的所有敌人然后出鞘，期间所有敌人处于定身状态，随后收刀，结束后对命中的所有敌人造成120-180点真实伤害，同时获得持续10秒的力量提升效果。", "锁定一定范围内的所有敌人然后出鞘，期间所有敌人处于定身状态，随后收刀，结束后对命中的所有敌人造成150-210点真实伤害，同时获得持续10秒的力量提升效果。"])
