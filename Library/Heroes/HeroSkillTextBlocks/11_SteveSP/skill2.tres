skill_name = "你会见证，落日的余晖"
skill_intro = Array[String](["瞄准较远距离单个生命值最高的敌人，随后立即秒杀该敌人，或对该敌人造成480点真实伤害，并眩晕目标2秒。", "瞄准较远距离单个生命值最高的敌人，随后立即秒杀该敌人，或对该敌人造成640点真实伤害，并眩晕目标2秒。", "瞄准较远距离单个生命值最高的敌人，随后立即秒杀该敌人，或对该敌人造成720点真实伤害，并眩晕目标2秒。"])
