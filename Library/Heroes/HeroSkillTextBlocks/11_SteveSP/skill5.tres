[ext_resource type="Script" path="res://Library/Heroes/hero_skill_text_block.gd" id="1_h00hl"]

[resource]
script = ExtResource("1_h00hl")
skill_name = "旅程的问答"
skill_intro = Array[String](["史蒂夫拥有“因何踏上旅程”和“仍有要守护之物”两个技能，每次使用技能都会切换到另一个技能进行冷却，前者造成总计360点范围伤害，后者创造一片持续5秒的增益领域。", "史蒂夫拥有“因何踏上旅程”和“仍有要守护之物”两个技能，每次使用技能都会切换到另一个技能进行冷却，前者造成总计480点范围伤害，后者创造一片持续7秒的增益领域。", "史蒂夫拥有“因何踏上旅程”和“仍有要守护之物”两个技能，每次使用技能都会切换到另一个技能进行冷却，前者造成总计600点范围伤害，后者创造一片持续10秒的增益领域。"])
