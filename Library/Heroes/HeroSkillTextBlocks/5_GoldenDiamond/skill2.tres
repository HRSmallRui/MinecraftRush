[ext_resource type="Script" path="res://Library/Heroes/hero_skill_text_block.gd" id="1_eeuml"]

[resource]
script = ExtResource("1_eeuml")
skill_name = "塔楼投资"
skill_intro = Array[String](["消耗一枚筹码，让周围一座防御塔射程或范围增加20%，攻击力提高30%，持续5秒，结束时返还60%筹码。", "消耗一枚筹码，让周围一座防御塔射程或范围增加20%，攻击力提高30%，持续8秒，结束时返还60%筹码。", "消耗一枚筹码，让周围一座防御塔射程或范围增加20%，攻击力提高30%，持续10秒，结束时返还60%筹码。"])
