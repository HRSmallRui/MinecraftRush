[ext_resource type="Script" path="res://Library/Heroes/hero_skill_text_block.gd" id="1_rlim1"]

[resource]
script = ExtResource("1_rlim1")
skill_name = "诈骗傀儡"
skill_intro = Array[String](["召唤1个傀儡，傀儡被赋予随机黑桃，红心，梅花，方块四种花色，最多存在10秒。四种傀儡分别擅长眩晕敌人，恢复我方单位，抵抗伤害，死亡自爆。", "召唤2个傀儡，傀儡被赋予随机黑桃，红心，梅花，方块四种花色，最多存在10秒。四种傀儡分别擅长眩晕敌人，恢复我方单位，抵抗伤害，死亡自爆。", "召唤3个傀儡，傀儡被赋予随机黑桃，红心，梅花，方块四种花色，最多存在10秒。四种傀儡分别擅长眩晕敌人，恢复我方单位，抵抗伤害，死亡自爆。"])
