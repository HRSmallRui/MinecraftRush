[gd_resource type="Resource" script_class="HeroSkillTextBlock" load_steps=2 format=3 uid="uid://cmcl2x77sq0tr"]

[ext_resource type="Script" path="res://Library/Heroes/hero_skill_text_block.gd" id="1_cyky7"]

[resource]
script = ExtResource("1_cyky7")
skill_name = "正反两面"
skill_intro = Array[String](["消耗一枚筹码投掷硬币，让较大范围内敌人赏金提高60%。若抛掷的硬币为正面，则敌人攻击力降低30%，命中率降低20%；若为反面，敌人易伤率增加50%，移速降低30%，持续6秒。", "消耗一枚筹码投掷硬币，让较大范围内敌人赏金提高60%。若抛掷的硬币为正面，则敌人攻击力降低45%，命中率降低40%；若为反面，敌人易伤率增加75%，移速降低50%，持续6秒。", "消耗一枚筹码投掷硬币，让较大范围内敌人赏金提高60%。若抛掷的硬币为正面，则敌人攻击力降低60%，命中率降低60%；若为反面，敌人易伤率增加100%，移速降低70%，持续6秒。"])
