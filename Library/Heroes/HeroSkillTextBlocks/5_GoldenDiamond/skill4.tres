skill_name = "塔罗赐福"
skill_intro = Array[String](["消耗一枚筹码抽取一张塔罗牌，对周围所有友军施加持续8秒的随机强化效果。", "消耗一枚筹码抽取一张塔罗牌，对周围所有友军施加持续8秒的随机强化效果。", "消耗一枚筹码抽取一张塔罗牌，对周围所有友军施加持续8秒的随机强化效果。"])
