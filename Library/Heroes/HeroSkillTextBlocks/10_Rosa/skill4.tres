skill_name = "暗影庇护"
skill_intro = Array[String](["蔷薇全身始终保持着黑暗效果，为蔷薇提供40%的闪避效果，有20%概率闪避范围伤害。", "蔷薇全身始终保持着黑暗效果，为蔷薇提供50%的闪避效果，有30%概率闪避范围伤害。", "蔷薇全身始终保持着黑暗效果，为蔷薇提供60%的闪避效果，有40%概率闪避范围伤害。"])
