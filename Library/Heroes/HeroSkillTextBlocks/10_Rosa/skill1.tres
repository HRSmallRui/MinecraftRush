skill_intro = Array[String](["快速射出10发箭，5发为物理伤害5发为魔法伤害，每发箭矢造成22-34点伤害。", "快速射出10发箭，5发为物理伤害5发为魔法伤害，每发箭矢造成34-46点伤害。", "快速射出10发箭，5发为物理伤害5发为魔法伤害，每发箭矢造成46-60点伤害。"])
