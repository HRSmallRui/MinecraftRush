script = ExtResource("1_8ajxk")
skill_name = "凋零·碎防"
skill_intro = Array[String](["蔷薇拔出腰间匕首立即对面前的敌人造成180点伤害，并且削除目标所有护甲。", "蔷薇拔出腰间匕首立即对面前的敌人造成240点伤害，并且削除目标所有护甲。", "蔷薇拔出腰间匕首立即对面前的敌人造成360点伤害，并且削除目标所有护甲。"])
