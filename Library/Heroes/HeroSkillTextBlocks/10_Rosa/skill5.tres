script = ExtResource("1_eee81")
skill_name = "黑暗风暴"
skill_intro = Array[String](["沿指定道路发射30发箭矢，持续覆盖大片区域，每发箭矢对小范围内的敌人造成40点真实伤害。", "沿指定道路发射45发箭矢，持续覆盖大片区域，每发箭矢对小范围内的敌人造成40点真实伤害。", "沿指定道路发射60发箭矢，持续覆盖大片区域，每发箭矢对小范围内的敌人造成40点真实伤害。"])
