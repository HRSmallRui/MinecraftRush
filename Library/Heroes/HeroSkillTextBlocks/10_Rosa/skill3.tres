[resource]
script = ExtResource("1_pex5q")
skill_name = "黑暗爆破"
skill_intro = Array[String](["蔷薇射出5发爆炸箭矢，对前方大范围区域进行轰炸，每发造成100点范围伤害。", "蔷薇射出5发爆炸箭矢，对前方大范围区域进行轰炸，每发造成150点范围伤害。", "蔷薇射出5发爆炸箭矢，对前方大范围区域进行轰炸，每发造成200点范围伤害。"])
