[resource]
script = ExtResource("1_lid5t")
skill_name = "索命·死亡空间"
skill_intro = Array[String](["创造一片持续4秒的时停领域，每0.1秒对领域内所有敌人造成2点真实伤害，并在结束时落下40把飞刀，对命中的单个敌人造成20点物理伤害。", "创造一片持续4秒的时停领域，每0.1秒对领域内所有敌人造成2点真实伤害，并在结束时落下40把飞刀，对命中的单个敌人造成25点物理伤害。", "创造一片持续4秒的时停领域，每0.1秒对领域内所有敌人造成2点真实伤害，并在结束时落下40把飞刀，对命中的单个敌人造成30点物理伤害。"])
