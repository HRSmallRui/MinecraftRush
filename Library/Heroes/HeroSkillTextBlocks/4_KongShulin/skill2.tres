[ext_resource type="Script" path="res://Library/Heroes/hero_skill_text_block.gd" id="1_viv3h"]

[resource]
script = ExtResource("1_viv3h")
skill_name = "索命·安魂"
skill_intro = Array[String](["对大范围敌人造成240-270点真实伤害，并施加“索命”效果，持续4秒，期间敌人的速度降低40%，并在死亡时立即补充自身1层命债。", "对大范围敌人造成300-350点真实伤害，并施加“索命”效果，持续7秒，期间敌人的速度降低40%，并在死亡时立即补充自身1层命债。", "对大范围敌人造成400-460点真实伤害，并施加“索命”效果，持续9秒，期间敌人的速度降低40%，并在死亡时立即补充自身1层命债。"])
