[resource]
script = ExtResource("2_e37ya")
hero_name = "史蒂夫"
hero_subname = "落日见证者"
hero_intro = "人族帝国九大守卫者，一生笃行 “守护” 信仰。曾是冲锋陷阵、浴血破阵的近战悍将，如今执起骨国统帅萨图恩的寒骨遗弓，化身百步穿杨的神射手，同时承袭尸国统帅赫斯菲的不朽剑术。骨弓引弦，是他见证厌皇如落日陨落的郑重承诺；锋剑出鞘，是他背负二人遗志的无畏担当。始终怀揣不变的守护之心，挽弓破暗、仗剑向前，一路奋战、永不停歇。"
