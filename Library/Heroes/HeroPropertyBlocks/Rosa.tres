[resource]
script = ExtResource("2_40rjt")
hero_name = "蔷薇"
hero_subname = "黯锋弩姬"
hero_intro = "紫发垂肩如暗夜凝霞，本是被底层刌民偶然拾获的人类女婴，在乡野间被温柔抚养长大。成年后她觉醒暗黑之力，能潜于阴影无声穿梭，箭矢裹着暗影锋芒，出手便取敌性命。厌皇压迫与高层刌民的迫害，让养父母惨死，悲痛中她集结底层同胞踏上复仇之路。当史蒂夫一行途经林地府邸时，她率部投靠，正式归入人族帝国，以黯锋弩矢射穿所有残暴与不公。"
hero_type = 1
max_healths = Array[int]([180, 200, 220, 240, 260, 280, 300, 320, 340, 360])
damage_nears = Array[ExtResource("1_lftos")]([SubResource("Resource_onn7v"), SubResource("Resource_x72e8"), SubResource("Resource_fgn4x"), SubResource("Resource_s50gj"), SubResource("Resource_pf7gk"), SubResource("Resource_gm6gx"), SubResource("Resource_xllp8"), SubResource("Resource_d1e4f"), SubResource("Resource_1ynil"), SubResource("Resource_8eg6c")])
