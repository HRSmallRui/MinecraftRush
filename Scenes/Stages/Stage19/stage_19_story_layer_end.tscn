text_exist_time = 3.0

[sub_resource type="Resource" id="Resource_mo1po"]
script = ExtResource("3_axjnq")
dialog_text = "我要赶时间回去"
text_color = Color(0, 0.462745, 0, 1)
text_exist_time = 6.0

[sub_resource type="Resource" id="Resource_buseu"]
script = ExtResource("3_axjnq")
