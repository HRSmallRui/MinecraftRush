text_exist_time = 8.0

[sub_resource type="Resource" id="Resource_3d1gh"]
script = ExtResource("3_axjnq")
dialog_text = "不，我的意思是"
text_color = Color(0, 1, 1, 1)
text_exist_time = 12.0

[sub_resource type="Resource" id="Resource_l6uor"]
script = ExtResource("3_axjnq")
dialog_text = "你能否肯接受我的礼物"
