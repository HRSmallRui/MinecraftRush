text_exist_time = 22.0

[sub_resource type="Resource" id="Resource_0aho6"]
script = ExtResource("3_axjnq")
dialog_text = "不是以两国将军的身份"
text_color = Color(0, 1, 1, 1)
text_exist_time = 23.0

[sub_resource type="Resource" id="Resource_najnl"]
script = ExtResource("3_axjnq")
dialog_text = "而是以你我二人曾短暂合作的份上，以个人名义"
text_color = Color(0, 1, 1, 1)
text_exist_time = 25.0

[sub_resource type="Resource" id="Resource_r1lqc"]
script = ExtResource("3_axjnq")
dialog_text = "呵"
