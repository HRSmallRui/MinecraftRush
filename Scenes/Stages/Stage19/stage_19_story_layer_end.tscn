text_exist_time = 15.0

[sub_resource type="Resource" id="Resource_4jb40"]
script = ExtResource("3_axjnq")
dialog_text = "以个人的名义，我们彼此之间交个朋友？"
text_color = Color(0, 1, 1, 1)
text_exist_time = 17.0

[sub_resource type="Resource" id="Resource_wa1mo"]
script = ExtResource("3_axjnq")
dialog_text = "朋友？"
