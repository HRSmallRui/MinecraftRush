[node name="SpecialTowersUnlockUI" parent="." index="24" instance=ExtResource("30_skg2d")]
show_texture = ExtResource("32_krppd")
show_name = "无人机控制平台"
tower_group = 3
tower_id = 5
bombard_intro_list = PackedStringArray("不同于寻常炮台，这些奇怪的家伙能够发射能量炮弹，锁定地面和飞行单位，对命中目标造成较低真实伤害，随后能量炮弹四散火花溅射伤害周围目标。", "以高能液体为动力的终极炮塔，可倾泻毁灭性火力，不过维护成本相当昂贵。同时得益于高能液体的放射性，被炮弹波及的敌人会被“放射病”折磨，不断减少生命的同时也会降低自身攻击力。", "演算者与帝国工程师联手打造的力作，操控无人机投掷炸弹轰炸地面目标，支持自由调遣无人机，大幅提升战术布局的灵活性。")

