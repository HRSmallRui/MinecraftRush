stream_1/stream = ExtResource("200_fk60e")

[node name="Stage20HatingEmperor" type="Node2D"]
process_mode = 1
script = ExtResource("1_d82cn")
boss_scene = ExtResource("2_ex8n5")
lightning_scene = ExtResource("3_670uu")
explosion_scene = ExtResource("4_s4u1r")
smoke_scene = ExtResource("5_0rk8i")
lock_tower_buff_scene = ExtResource("6_45fvo")
hit_lightning_area_scene = ExtResource("7_abndl")
lightning_cd_min = 13.0
lightning_cd_max = 66.0
start_text = "尔等能走到此地，是吾之慈悲。"
on_fighting_text = "准备迎接人类灭亡的命运吧。"
preparing_text_list = Array[String](["百年前，先祖曾率军踏破过另一国度的土地，今日尔等小国将面临同样的命运。", "吾即雷鸣之化身，厌鸣的无敌部队将踏破这里的每一寸土地。", "颤抖吧，人类。", "吾早已成神，尔等以为这凡间俗物可以阻挡吾之神威吗。", "濒死的羔羊，妄图做最后无用的抵抗吗？"])
fighting_text_list = Array[String](["当那个蠢货用举国生灵点燃“禁术”换取神姿之时，或许不曾想到这神器终将回到厌鸣的手中。现在，你们就是历史悲剧的重演。", "先祖没看透的真相——神器需要的不是蛮力，而是共鸣！现在的雷光，连神都会颤抖！", "瞧这雷光中闪烁的亡魂面孔——那小国的冤魂还在为神器悲鸣？但它们的诅咒，只会成为我力量的养料！", "跪下！在雷神的面前！", "你们以为先前暂时的扭转战局的渺小“奇迹”是神明的庇佑？不过是吾之慈悲，允许尔等在灭亡前多喘两口气罢了。", "从地狱爬回来的阴暗爬虫，以为带几支残兵败将就能改写灭亡的历史？", "听到了吗？亡魂在笑——笑尔等之徒劳。", "尔等每喘一口气，都是吾对历史之施舍。", "雷光不度蝼蚁——尔等连做吾踏脚石之资格都勉强。", "甚好，吾能感受到尔等之无能狂怒。", "绝望吧，仇恨吧，愤怒吧——然后，在雷光中化为虚无。", "不过区区凡人，妄图阻挠吾？笑话！", "厌鸣的无敌部队，将会踏破尔等小国的每一寸土地。九泉之下，尔等将会团聚的，这点大可放心。", "不过是些凡间俗物，尔等蝼蚁以为如此便可阻止吾之霸业吗？", "吾早已成神，何来败亡一说？"])
boss_coming_text = "退下！一群废柴！还需吾亲自送尔等上路！"

