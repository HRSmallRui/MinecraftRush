text_exist_time = 2.0

[sub_resource type="Resource" id="Resource_uhabe"]
script = ExtResource("2_4olrb")
dialog_text = "嗯"
text_color = Color(0, 1, 1, 1)
text_exist_time = 4.0

[sub_resource type="Resource" id="Resource_jlm5n"]
script = ExtResource("2_4olrb")
dialog_text = "但我早已解甲归田，护着周遭百姓安稳度日"
text_color = Color(0, 1, 1, 1)
text_exist_time = 6.0

[sub_resource type="Resource" id="Resource_actrx"]
script = ExtResource("2_4olrb")
dialog_text = "为何偏偏这个时候召我回去……"
text_color = Color(0, 1, 1, 1)
text_exist_time = 10.0

[sub_resource type="Resource" id="Resource_jawsa"]
script = ExtResource("2_4olrb")
dialog_text = ""
