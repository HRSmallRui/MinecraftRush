text_exist_time = 13.0

[sub_resource type="Resource" id="Resource_qqkcr"]
script = ExtResource("2_4olrb")
dialog_text = "孩子，我知道你早已厌倦"
text_color = Color(0, 0, 1, 1)
text_exist_time = 14.0

[sub_resource type="Resource" id="Resource_dapai"]
script = ExtResource("2_4olrb")
dialog_text = "那场战争不是你的错，你不必如此"
text_color = Color(0, 0, 1, 1)
text_exist_time = 18.0

[sub_resource type="Resource" id="Resource_0nehf"]
script = ExtResource("2_4olrb")
dialog_text = "我如今只想在这边境地区保护周遭百姓免受那群怪物的攻击……"
text_color = Color(0, 1, 1, 1)
text_exist_time = 22.0

[sub_resource type="Resource" id="Resource_yxb8a"]
script = ExtResource("2_4olrb")
dialog_text = "我知道，孩子，我知道……"
text_color = Color(0, 0, 1, 1)
text_exist_time = 29.0

[sub_resource type="Resource" id="Resource_tjcag"]
script = ExtResource("2_4olrb")
dialog_text = "但"
text_color = Color(0, 0, 1, 1)
text_exist_time = 33.0

[sub_resource type="Resource" id="Resource_ojlb3"]
script = ExtResource("2_4olrb")
dialog_text = "这是你的命……"
text_color = Color(0, 0, 1, 1)
text_exist_time = 35.0

[sub_resource type="Resource" id="Resource_wt147"]
script = ExtResource("2_4olrb")
dialog_text = "你是人族的九大守卫者之一，你不应只局限于这一方小小天地，护“小家”"
text_color = Color(0, 0, 1, 1)
text_exist_time = 37.0

[sub_resource type="Resource" id="Resource_rcoww"]
script = ExtResource("2_4olrb")
dialog_text = "你应前去，护“大家”"
text_color = Color(0, 0, 1, 1)
text_exist_time = 46.0

